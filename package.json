    "canvaskit-wasm": "^0.42.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "release-it": "^21.1.0",
    "svg2pdf.js": "^2.8.1",
    "typescript": "^6.0.0",

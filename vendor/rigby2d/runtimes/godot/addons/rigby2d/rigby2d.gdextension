[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/rigby2d/bin/rigby_godot.dll"
windows.release.x86_64 = "res://addons/rigby2d/bin/rigby_godot.dll"
linux.debug.x86_64 = "res://addons/rigby2d/bin/librigby_godot.so"
linux.release.x86_64 = "res://addons/rigby2d/bin/librigby_godot.so"
macos.debug = "res://addons/rigby2d/bin/librigby_godot.dylib"
macos.release = "res://addons/rigby2d/bin/librigby_godot.dylib"
